PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/homebase

# Required for production. Use a long random passcode and a 32+ character secret.
HOMEBASE_ACCESS_CODE=change-me-to-a-long-private-passcode
HOMEBASE_SESSION_SECRET=change-me-to-at-least-32-random-characters
HOMEBASE_REQUIRE_AUTH=true
HOMEBASE_COOKIE_SAME_SITE=none
HOMEBASE_COOKIE_PARTITIONED=true

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173

# Set true when running behind a trusted reverse proxy such as Render/Fly/NGINX.
TRUST_PROXY=false

# Optional: assignee=https://calendar.example/private.ics,us=https://calendar.example/shared.ics
GCAL_ICAL_URLS=
