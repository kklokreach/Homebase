{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "preinstall": "node ./scripts/src/preinstall.mjs",
    "prebuild": "pnpm run typecheck",
    "build": "pnpm -r --workspace-concurrency=1 --if-present run build",
    "typecheck:libs": "node ./node_modules/typescript/bin/tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --workspace-concurrency=1 --filter \"./lib/**\" --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.3"
  }
}
